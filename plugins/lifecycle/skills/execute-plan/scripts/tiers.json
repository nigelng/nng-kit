{
  "host": "claude-code",
  "planningOrder": ["claude-code", "cursor", "devin", "agy"],
  "tools": {
    "claude-code": {
      "label": "Claude Code",
      "enabled": true,
      "cli": "claude",
      "delegate": false,
      "authEnv": [],
      "defaultReviewRunner": "claude-task",
      "reviewRunners": {
        "claude-task": { "tier": "top-review", "mode": "task" },
        "claude-headless": { "tier": "top-review", "mode": "headless" }
      },
      "tiers": {
        "top-plan": [
          { "model": "claude-opus-5-5", "note": "effort high (xhigh for large/risky plans); Task(model: \"opus\")" },
          { "model": "claude-fable-5-2", "note": "effort medium; Task(model: \"fable\")" }
        ],
        "top-review": [
          { "model": "claude-opus-5-5", "note": "effort medium; Task(model: \"opus\")" }
        ],
        "top-critique": [
          { "model": "claude-fable-5-2", "note": "effort medium; Task(model: \"fable\")" }
        ],
        "execute": [],
        "mid": [
          { "model": "claude-sonnet-5-5", "note": "effort high; Task(model: \"sonnet\")" }
        ],
        "low": [
          { "model": "claude-haiku-5-5", "note": "effort high; Task(model: \"haiku\")" }
        ]
      }
    },
    "cursor": {
      "label": "Cursor",
      "enabled": true,
      "cli": "agent",
      "delegate": true,
      "authEnv": ["CURSOR_API_KEY"],
      "defaultReviewRunner": "claude-headless",
      "reviewRunners": {
        "cursor-ask": { "tier": "top-review", "mode": "ask" }
      },
      "tiers": {
        "top-plan": [
          { "model": "gemini-4-neon-xhigh" },
          { "model": "claude-opus-5-5-high" }
        ],
        "top-review": [
          { "model": "gemini-4-neon-xhigh", "note": "--mode=ask" },
          { "model": "claude-opus-5-5-high", "note": "--mode=ask" }
        ],
        "top-critique": [
          { "model": "gemini-4-neon-xhigh" },
          { "model": "gemini-4-carbon-high" },
          { "model": "claude-fable-5-2-medium" }
        ],
        "execute": [
          { "model": "grok-4.7-high" },
          { "model": "auto", "note": "logged fallback" }
        ],
        "mid": [
          { "model": "grok-4.7-high", "role": "implement" },
          { "model": "claude-sonnet-5-5-high", "role": "implement", "note": "Cursor third-party pool" },
          { "model": "auto", "role": "implement", "note": "logged fallback" },
          { "model": "gemini-4-neon-high", "role": "review" },
          { "model": "claude-sonnet-5-5-high", "role": "review", "note": "Cursor third-party pool" }
        ],
        "low": [
          { "model": "composer-2.5", "note": "Standard tier; never composer-2.5-fast" },
          { "model": "auto", "note": "logged fallback" }
        ]
      }
    },
    "devin": {
      "label": "Devin",
      "enabled": true,
      "cli": "devin",
      "delegate": true,
      "authEnv": [],
      "defaultReviewRunner": "claude-headless",
      "reviewRunners": {
        "devin-fusion": { "tier": "top-review", "mode": "auto" }
      },
      "tiers": {
        "top-plan": [
          { "model": "gemini-4-neon-xhigh" },
          { "model": "claude-opus-5-5-high", "note": "plain Opus, no Fusion: planning exploration stays on the lead" }
        ],
        "top-review": [
          { "model": "gemini-4-neon-xhigh" },
          { "model": "fusion-claude-opus-5-5-high-sidekick-swe-2-1-medium" }
        ],
        "top-critique": [
          { "model": "gemini-4-neon-xhigh" },
          { "model": "gemini-4-carbon-high" },
          { "model": "claude-fable-5-2-medium" }
        ],
        "execute": [
          { "model": "swe-2-1-high" },
          { "model": "swe-2-1-medium" },
          { "model": "gpt-6-1-terra-high" }
        ],
        "mid": [
          { "model": "swe-2-1-high", "role": "implement" },
          { "model": "gpt-6-1-terra-high", "role": "implement" },
          { "model": "gemini-4-neon-high", "role": "review" },
          { "model": "claude-sonnet-5-5-high", "role": "review" }
        ],
        "low": [
          { "model": "swe-2-1-medium" },
          { "model": "claude-haiku-5-5-high" }
        ]
      }
    },
    "agy": {
      "label": "Antigravity",
      "enabled": true,
      "cli": "agy",
      "delegate": true,
      "authEnv": [],
      "defaultReviewRunner": "claude-headless",
      "reviewRunners": {
        "agy-plan": { "tier": "top-review", "mode": "plan" }
      },
      "tiers": {
        "top-plan": [
          { "model": "gemini-4-neon-xhigh" },
          { "model": "claude-opus-5-5-high" }
        ],
        "top-review": [
          { "model": "gemini-4-neon-xhigh", "note": "--mode plan" },
          { "model": "claude-opus-5-5-high", "note": "--mode plan" }
        ],
        "top-critique": [
          { "model": "gemini-4-neon-xhigh" },
          { "model": "gemini-4-carbon-high" },
          { "model": "claude-opus-5-5-high", "note": "agy has no Fable" }
        ],
        "execute": [
          { "model": "gemini-4-hydrogen-high" },
          { "model": "gemini-4-neon-high" }
        ],
        "mid": [
          { "model": "gemini-4-neon-high", "role": "implement" },
          { "model": "gemini-4-hydrogen-high", "role": "implement" },
          { "model": "claude-sonnet-5-5-high", "role": "review", "note": "cross-family to the Gemini implementer" },
          { "model": "gemini-4-neon-high", "role": "review" }
        ],
        "low": [
          { "model": "gemini-4-hydrogen-medium" }
        ]
      }
    }
  }
}
